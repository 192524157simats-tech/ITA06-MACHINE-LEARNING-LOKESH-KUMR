import csv

data = list(csv.reader(open("data.csv")))[1:]
n = len(data[0]) - 1

S = ['0'] * n
G = [['?'] * n]

for row in data:
    x, y = row[:-1], row[-1]

    if y == 'Yes':
        for i in range(n):
            if S[i] == '0':
                S[i] = x[i]
            elif S[i] != x[i]:
                S[i] = '?'
    else:
        for g in G:
            for i in range(n):
                if g[i] == '?':
                    g[i] = S[i]

print("Specific Boundary:", S)
print("General Boundary:", G)
